PORT=8080
ROUTE_PREFIX=/coral
API_KEY=你的高强度安全密钥_sk_live_xxxxxx

# 数据持久化目录：
# - 本地开发环境：可保持 ./data
# - 云平台部署（orkestr / Miget / Blitz / Docker / K8s）：
#   建议挂载持久存储卷（Persistent Volume）并填写绝对路径，如 /data 或 /app/data
DATA_DIR=/data

# 微信防骚扰保活与配额参数
MAX_QUOTA=10
BATCH_WINDOW_MS=2500

# Token 到期前半小时自动触发外部 Webhook 配置
TRIGGER_WEBHOOK_URL=http://job.coral.cc.cd/api/trigger/tasks/6
TRIGGER_AUTH_KEY=your_secret_token_here

# ==============================================================================
# 多节点跨云高可用集群配置 (基于动态服务注册中心，O(1) 增减节点)
#
# 原理与机制：
# 1. 新开任何免费云服务，只需填入 REGISTRY_URL 与当前容器的 SELF_URL；
# 2. 节点启动后会自动上报自身并拉取全网存活节点列表，老节点在 60 秒内自动发现新节点并组网；
# 3. 缩减或销毁节点时，超过 3 分钟未上报心跳将由 Worker 自动注销剔除，现有容器 0 修改；
# 4. 节点选举：NODE_ROLE=auto 配合 NODE_PRIORITY 权重（100 > 80 > 60）秒级自动选举与抢占。
# ==============================================================================

# 注册中心地址（指向 Cloudflare Worker 部署地址，结尾 /coral/api/registry 或 /api/registry 均可）
REGISTRY_URL=https://your-worker.yourdomain.workers.dev/coral/api/registry

# 注册中心同步心跳周期（毫秒，默认 60000ms / 60 秒，保护 Cloudflare 免费配额）
# REGISTRY_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 【各节点具体配置模板】
# ------------------------------------------------------------------------------

# 【节点 1：orkestr（第一主节点）】
# NODE_ROLE=auto
# NODE_PRIORITY=100
# SELF_URL=https://clawbot-orkestr.yourdomain.com

# 【节点 2：Miget（第一备用节点）】
# NODE_ROLE=auto
# NODE_PRIORITY=80
# SELF_URL=https://clawbot-miget.yourdomain.com

# 【节点 3：Blitz.cloud（第二备用节点）】
# NODE_ROLE=auto
# NODE_PRIORITY=60
# SELF_URL=https://clawbot-blitz.cloud.yourdomain.com

# 【节点 4：Koyeb / Render / Hugging Face（任意新增备用节点）】
# NODE_ROLE=auto
# NODE_PRIORITY=50
# SELF_URL=https://clawbot-newnode.yourdomain.com

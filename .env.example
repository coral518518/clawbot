PORT=8080
ROUTE_PREFIX=/coral
API_KEY=你的高强度安全密钥_sk_live_xxxxxx

# 数据持久化目录：
# - 本地开发环境：可保持 ./data
# - 云平台部署（Netrun / Miget / Blitz / Docker / K8s）：
#   建议挂载持久存储卷（Persistent Volume）并填写绝对路径，如 /data 或 /app/data
DATA_DIR=/data

# 微信防骚扰保活与配额参数
MAX_QUOTA=10
BATCH_WINDOW_MS=2500

# Token 到期前半小时自动触发外部 Webhook 配置
TRIGGER_WEBHOOK_URL=http://job.coral.cc.cd/api/trigger/tasks/6
TRIGGER_AUTH_KEY=your_secret_token_here

# ==============================================================================
# 多节点跨云高可用集群配置 (Netrun.io > Miget > Blitz.cloud 三节点热备)
# 机制：
# 1. PEER_URLS: 填写除当前节点外，其他所有节点的访问 URL，多个用英文逗号分隔；
# 2. NODE_ROLE: 本机角色，建议主节点填 master，备节点填 standby 或 auto；
# 3. NODE_PRIORITY: 节点选举权重（数值越大优先级越高）。Netrun(100) > Miget(80) > Blitz(60)；
# 4. 容灾行为：主节点故障时，存活备机中权重最高的自动接管，主节点恢复时优雅让出。
# ==============================================================================

# ------------------------------------------------------------------------------
# 【节点 1 配置模板：Netrun.io（第一主节点 · 运行长轮询与守护任务）】
# ------------------------------------------------------------------------------
# NODE_ROLE=master
# NODE_PRIORITY=100
# PEER_URLS=https://clawbot-miget.yourdomain.com,https://clawbot-blitz.cloud.yourdomain.com

# ------------------------------------------------------------------------------
# 【节点 2 配置模板：Miget（第一备用节点 · 静默待命，Netrun 故障时优先接管）】
# ------------------------------------------------------------------------------
# NODE_ROLE=standby
# NODE_PRIORITY=80
# PEER_URLS=https://clawbot-netrun.yourdomain.com,https://clawbot-blitz.cloud.yourdomain.com

# ------------------------------------------------------------------------------
# 【节点 3 配置模板：Blitz.cloud（第二备用节点 · Netrun 和 Miget 均故障时兜底接管）】
# ------------------------------------------------------------------------------
# NODE_ROLE=standby
# NODE_PRIORITY=60
# PEER_URLS=https://clawbot-netrun.yourdomain.com,https://clawbot-miget.yourdomain.com

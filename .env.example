PORT=8080
ROUTE_PREFIX=/coral
API_KEY=你的高强度安全密钥_sk_live_xxxxxx
# 数据持久化目录：
# - 本地开发环境：可保持 ./data
# - 云平台部署（Miget / Docker / K8s）：建议挂载持久存储卷（Persistent Volume）并填写绝对路径，如 /data 或 /app/data（请勿使用相对路径 ./data）
DATA_DIR=./data

# 微信防骚扰保活与配额参数
MAX_QUOTA=10
BATCH_WINDOW_MS=2500

# Token 到期前半小时自动触发外部 Webhook 配置
TRIGGER_WEBHOOK_URL=http://job.coral.cc.cd/api/trigger/tasks/6
TRIGGER_AUTH_KEY=your_secret_token_here

# 双机高可用热备集群配置 (如 Blitz Cloud <-> Miget 跨云热备)
# - PEER_URL: 对端节点完整 URL (例如: https://clawbot.coral.blitz.cloud 或 https://clawbot-n4k1y.us-east-1.migetapp.com)
# - NODE_ROLE: 本节点角色。可选: master (主机/默认跑长轮询) | standby (备机/静默待命) | auto (自动选举)
# PEER_URL=https://clawbot.coral.blitz.cloud
# NODE_ROLE=auto

